# Wordt ALLEEN lokaal gebruikt. Plaats geen echte sleutel in het project of een gedeelde repository.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1
# Optioneel voor publicatie; stel echte waarden veilig in, nooit in Git.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
# Optionele Confluence Cloud-koppeling (geen echte sleutels in dit bestand).
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACE_ID=
CONFLUENCE_PARENT_ID=
# Alleen lokaal voor publication_service.py; eigen veilige ASCII-sleutel van minimaal 24 tekens.
PSA_SERVICE_TOKEN=
# Optionele Notion-epicselectie: deel deze database met de Notion-integratie.
# De bronlink gebruikt dit ID als standaard; stel het echte database-ID in als de link een bovenliggende pagina is.
NOTION_EPICS_DATABASE_ID=e9375da1-9602-49bb-a23c-49d038d3c888
